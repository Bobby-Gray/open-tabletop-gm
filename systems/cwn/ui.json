{
  "manifest_version": 1,
  "system": "cwn",
  "label": "Compatible with Cities Without Number",
  "_comment": "Widgets self-hide when their bound field is absent, so this declares the superset. Differences from the dnd5e manifest: a System Strain bar (current includes permanent strain; max is the CON score adjusted by lifestyle) and an Access bar for hackers, both require_cur so they draw only for a character that has them; two ACs, because ranged and melee attacks target different numbers; Trauma Target and the four save targets as stat lines; no hit dice and no spell slots. The attribute grid shows the pushed modifier as-is, because this system's curve is flatter than the d20 one (14-17 is +1) and the renderer derives nothing. No Effort line: Effort belongs to the SRD's magic chapter, which this module omits. See systems/UI-MANIFEST.md for the widget catalog.",
  "sidebar": [
    {
      "type": "bar",
      "label": "HP",
      "bind": "hp",
      "icon": "/icons/enemy.png",
      "row_class": "sb-hp-row",
      "num_class": "sb-hp-nums",
      "fill_role": "hp-fill",
      "cur": "current",
      "max": "max",
      "color": "hp",
      "temp": "temp"
    },
    {
      "type": "bar",
      "label": "Strain",
      "bind": "system_strain",
      "icon": "/icons/potion.png",
      "cur": "current",
      "max": "max",
      "require_cur": true
    },
    {
      "type": "bar",
      "label": "Access",
      "bind": "access",
      "icon": "/icons/focus.png",
      "cur": "current",
      "max": "max",
      "require_cur": true
    },
    {
      "type": "bar",
      "label": "XP",
      "bind": "xp",
      "icon": "/icons/ability.png",
      "row_class": "sb-xp-row",
      "num_class": "sb-xp-nums",
      "fill_role": "xp-fill",
      "fill_class": "sb-xp-bar",
      "cur": "current",
      "max": "next",
      "require_cur": true
    },
    {
      "type": "stat_lines",
      "lines": [
        { "label": "AC", "bind": "ac" },
        { "label": "TT", "bind": "trauma_target" },
        { "label": "Atk", "bind": "attack_bonus" },
        { "label": "Phys", "bind": "saves.physical" },
        { "label": "Evas", "bind": "saves.evasion" },
        { "label": "Ment", "bind": "saves.mental" },
        { "label": "Luck", "bind": "saves.luck" }
      ],
      "_comment": "Push ac as \"16/13\" (ranged/melee). Save values are TARGETS to roll at or over on a d20, not bonuses."
    },
    {
      "type": "tag_list",
      "bind": "conditions",
      "class_map": {
        "mortally wounded": "danger",
        "unconscious": "danger",
        "coma": "danger",
        "internal damage": "danger",
        "brain damage": "danger",
        "psychosis": "danger",
        "frail": "warn",
        "gut wound": "warn",
        "blinded": "warn",
        "leg ruined": "warn",
        "arm ruined": "warn",
        "stunned": "warn",
        "poisoned": "warn",
        "grappled": "info",
        "prone": "info",
        "surprised": "info",
        "jacked in": "info",
        "total defense": "buff",
        "hidden": "buff"
      }
    },
    {
      "type": "effects",
      "bind": "effects"
    },
    {
      "type": "badge_set",
      "bind": "milestones"
    }
  ],
  "sheet": {
    "combat_strip": [
      { "label": "HP", "bind": "hp", "format": "ratio" },
      { "label": "Strain", "bind": "system_strain", "format": "ratio" },
      { "label": "AC (R/M)", "bind": "ac" },
      { "label": "Trauma Target", "bind": "trauma_target" },
      { "label": "Attack", "bind": "attack_bonus" },
      { "label": "Access", "bind": "access", "format": "ratio" }
    ],
    "stat_grid": {
      "label": "Attributes",
      "bind": "ability_scores",
      "show_modifier": true,
      "stats": [
        { "key": "str", "label": "STR" },
        { "key": "dex", "label": "DEX" },
        { "key": "con", "label": "CON" },
        { "key": "int", "label": "INT" },
        { "key": "wis", "label": "WIS" },
        { "key": "cha", "label": "CHA" }
      ],
      "_comment": "Push { \"str\": {\"score\": 14, \"mod\": \"+1\"}, ... } with the modifier from this system's curve: 3 is -2, 4-7 -1, 8-13 +0, 14-17 +1, 18 +2."
    }
  },
  "default_scene": "cp_street",
  "scenes": {
